# Non-secret example only. Put the replacement key in local .env, never in chat.
# Integration tests read these three local .env settings only after explicit
# opt-in. Offline Agent core never reads this file. Set RUN_AGENT_REAL_LLM_VALIDATION
# in the test process environment; it is intentionally not read from .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AGENT_OPENAI_MODEL=deepseek-flash
RUN_AGENT_REAL_LLM_VALIDATION=1
